{
  "name": "dsh-trace-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Independent DSH Trace workbench and local data management plugin",
  "type": "module",
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vibeinging/dsh-trace.git"
  },
  "homepage": "https://github.com/vibeinging/dsh-trace#readme",
  "bugs": {
    "url": "https://github.com/vibeinging/dsh-trace/issues"
  },
  "scripts": {
    "build": "pnpm --filter @vibeinging/dsh-trace-viewer run build",
    "watch": "pnpm --filter @vibeinging/dsh-trace-viewer run watch",
    "lint": "pnpm --filter @vibeinging/dsh-trace-viewer run lint",
    "typecheck": "pnpm --filter @vibeinging/dsh-trace-viewer run typecheck",
    "test": "pnpm --filter @vibeinging/dsh-trace-viewer run test",
    "check:package": "pnpm --filter @vibeinging/dsh-trace-viewer run check:package",
    "check:rules": "node scripts/check-repository-rules.mjs",
    "check": "pnpm run check:rules && pnpm --filter @vibeinging/dsh-trace-viewer run check"
  }
}
